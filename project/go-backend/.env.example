# Sunucu
PORT=8080
ENV=development

# Render'da Postgres eklentisi oluşturunca sana "Internal Database URL" verir
DATABASE_URL=

# Rastgele, uzun bir secret üret (örn: openssl rand -base64 32)
JWT_SECRET=

# Vercel'e deploy ettiğin frontend URL'i (CORS için)
ALLOWED_ORIGIN=http://localhost:3000

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
