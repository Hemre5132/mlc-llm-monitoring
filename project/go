const AppVersion = "0.1.0"

type CommonHandler struct {
	DB *gorm.DB
}

func NewCommonHandler(db *gorm.DB) *CommonHandler {
	return &CommonHandler{DB: db}
}

// ---------- 19) GET /api/health ----------
// Render'ın health check probe'u bu endpoint'i düzenli olarak yoklar.

func (h *CommonHandler) Health(c *gin.Context) {
	sqlDB, err := h.DB.DB()
	dbOK := err == nil && sqlDB.Ping() == nil

	status := http.StatusOK
	if !dbOK {
		status = http.StatusServiceUnavailable
	}

	c.JSON(status, gin.H{
		"status": map[bool]string{true: "ok", false: "degraded"}[dbOK],
		"db":     dbOK,
	})
}

// ---------- 20) GET /api/version ----------

func (h *CommonHandler) Version(c *gin.Context) {
	c.JSON(http.StatusOK, gin.H{"version": AppVersion})
}

// ---------- 21) GET /api/stats/dashboard ----------
// Dashboard view'ının besleneceği essay bazlı istatistikler.

func (h *CommonHandler) DashboardStats(c *gin.Context) {
	userID, exists := c.Get("user_id")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "yetkisiz erişim"})
		return
	}

	uid := userID.(uuid.UUID)
	stats, err := h.buildEssayStats(uid)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "istatistikler alınamadı"})
		return
	}

	c.JSON(http.StatusOK, stats)
}

// ---------- 22) GET /api/stats/me ----------
// Giriş yapmış kullanıcıya özel özet istatistikler.

func (h *CommonHandler) MyStats(c *gin.Context) {
	userID := c.MustGet("user_id").(uuid.UUID)

	var totalEssays int64
	var avgScore float64

	if err := dbQueryDuration("my_stats", func() error {
		return h.DB.Table("essays").Where("user_id = ?", userID).Count(&totalEssays).Error
	}); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "kişisel essay istatistikleri alınamadı"})
		return
	}
	if err := dbQueryDuration("my_stats", func() error {
		return h.DB.Table("essay_scores").
			Joins("JOIN essays ON essays.id = essay_scores.essay_id").
			Where("essays.user_id = ?", userID).
			Select("COALESCE(AVG(essay_scores.overall_score), 0)").
			Scan(&avgScore).Error
	}); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "kişisel skor istatistikleri alınamadı"})
		return
	}

	c.JSON(http.StatusOK, gin.H{
		"total_essays":  totalEssays,
		"average_score": avgScore,
	})
}

// ---------- GET /api/stats/streak ----------
// Faz 2: Kullanıcının art arda kaç gün essay yazdığını hesaplar.
// essays.created_at tarihlerini DISTINCT DATE ile çeker, azalan sırada
// tarayarak ardışık gün sayısını bulur.

func (h *CommonHandler) Streak(c *gin.Context) {
	userID := c.MustGet("user_id").(uuid.UUID)

	var dates []time.Time
	if err := dbQueryDuration("streak", func() error {
		return h.DB.Table("essays").
			Where("user_id = ?", userID).
			Distinct("DATE(created_at)").
			Order("DATE(created_at) desc").
			Pluck("DATE(created_at)", &dates).Error
	}); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "streak hesaplanamadı"})
		return
	}

	currentStreak, longestStreak := calculateStreak(dates)

	c.JSON(http.StatusOK, gin.H{
		"current_streak": currentStreak,
		"longest_streak": longestStreak,
	})
}

// calculateStreak, azalan sıradaki tarih listesinden ardışık gün sayısını hesaplar.
func calculateStreak(dates []time.Time) (current, longest int) {
	if len(dates) == 0 {
		return 0, 0
	}

	// Tarihleri gün bazında normalize et
	daySet := make(map[string]bool)
	for _, d := range dates {
		daySet[d.Format("2006-01-02")] = true
	}

	// En uzun streak'i bul
	keys := make([]string, 0, len(daySet))
	for k := range daySet {
		keys = append(keys, k)
	}

	// Basit yaklaşım: tüm günleri sırala ve ardışıklığı say
	// (Küçük veri setleri için yeterli; büyük setlerde SQL tarafında yapılabilir)
	dayList := make([]time.Time, 0, len(keys))
	for _, k := range keys {
		t, err := time.Parse("2006-01-02", k)
		if err == nil {
			dayList = append(dayList, t)
		}
	}

	// Azalan sırala
	for i := 0; i < len(dayList); i++ {
		for j := i + 1; j < len(dayList); j++ {
			if dayList[j].After(dayList[i]) {
				dayList[i], dayList[j] = dayList[j], dayList[i]
			}
		}
	}

	// Ardışık günleri say
	run := 1
	longest = 1
	for i := 1; i < len(dayList); i++ {
		diff := dayList[i-1].Sub(dayList[i]).Hours() / 24
		if diff == 1 {
			run++
			if run > longest {
				longest = run
			}
		} else {
			run = 1
		}
	}

	// Current streak: bugün veya dün yazdıysa devam ediyor demektir
	today := time.Now().Format("2006-01-02")
	yesterday := time.Now().AddDate(0, 0, -1).Format("2006-01-02")

	current = 0
	if daySet[today] || daySet[yesterday] {
		current = run
		// Bugün yazmadıysa ama dün yazdıysa, streak dünden itibaren sayılır
		if !daySet[today] {
			current = run - 1
			if current < 0 {
				current = 0
			}
		}
	}

	return current, longest
}

// buildEssayStats, kullanıcının essay istatistiklerini toplar.
// Response şeması:
//
//	{
//	  "total_essays": 12,
//	  "average_score": 74.3,
//	  "criteria_averages": {...},
//	  "weakest_criterion": "grammar_accuracy",
//	  "error_category_counts": {...},
//	  "recent_essays": [...]
//	}
func (h *CommonHandler) buildEssayStats(userID uuid.UUID) (gin.H, error) {
	var totalEssays int64
	var avgScore float64

	if err := dbQueryDuration("dashboard_stats", func() error {
		return h.DB.Table("essays").Where("user_id = ?", userID).Count(&totalEssays).Error
	}); err != nil {
		return nil, err
	}
	if err := dbQueryDuration("dashboard_stats", func() error {
		return h.DB.Table("essay_scores").
			Joins("JOIN essays ON essays.id = essay_scores.essay_id").
			Where("essays.user_id = ?", userID).
			Select("COALESCE(AVG(essay_scores.overall_score), 0)").
			Scan(&avgScore).Error
	}); err != nil {
		return nil, err
	}

	// Kriter ortalamaları
	var criteriaAverages struct {
		TaskAchievement   float64 `gorm:"column:task_achievement"`
		CoherenceCohesion float64 `gorm:"column:coherence_cohesion"`
		GrammarAccuracy   float64 `gorm:"column:grammar_accuracy"`
		VocabularyRange   float64 `gorm:"column:vocabulary_range"`
		SpellingMechanics float64 `gorm:"column:spelling_mechanics"`
		SentenceStructure float64 `gorm:"column:sentence_structure"`
	}
	if err := dbQueryDuration("dashboard_stats", func() error {
		return h.DB.Table("essay_scores").
			Joins("JOIN essays ON essays.id = essay_scores.essay_id").
			Where("essays.user_id = ?", userID).
			Select("COALESCE(AVG(task_achievement), 0) as task_achievement, COALESCE(AVG(coherence_cohesion), 0) as coherence_cohesion, COALESCE(AVG(grammar_accuracy), 0) as grammar_accuracy, COALESCE(AVG(vocabulary_range), 0) as vocabulary_range, COALESCE(AVG(spelling_mechanics), 0) as spelling_mechanics, COALESCE(AVG(sentence_structure), 0) as sentence_structure").
			Scan(&criteriaAverages).Error
	}); err != nil {
		return nil, err
	}

	criteriaMap := map[string]float64{
		"task_achievement":   criteriaAverages.TaskAchievement,
		"coherence_cohesion": criteriaAverages.CoherenceCohesion,
		"grammar_accuracy":   criteriaAverages.GrammarAccuracy,
		"vocabulary_range":   criteriaAverages.VocabularyRange,
		"spelling_mechanics": criteriaAverages.SpellingMechanics,
		"sentence_structure": criteriaAverages.SentenceStructure,
	}

	// En zayıf kriteri bul
	weakest := "task_achievement"
	weakestVal := criteriaMap[weakest]
	for k, v := range criteriaMap {
		if v < weakestVal {
			weakest = k
			weakestVal = v
		}
	}

	// Hata kategorisi sayıları (Go tarafında JSON parse ederek)
	errorCategoryCounts := map[string]int{
		"grammar":            0,
		"vocabulary":         0,
		"spelling":           0,
		"punctuation":        0,
		"sentence_structure": 0,
	}
	var errorLists []string
	if err := dbQueryDuration("dashboard_stats", func() error {
		return h.DB.Table("essay_scores").
			Joins("JOIN essays ON essays.id = essay_scores.essay_id").
			Where("essays.user_id = ?", userID).
			Pluck("essay_scores.error_list", &errorLists).Error
	}); err != nil {
		return nil, err
	}
	for _, raw := range errorLists {
		if raw == "" {
			continue
		}
		var errors []models.EssayError
		if err := json.Unmarshal([]byte(raw), &errors); err != nil {
			continue
		}
		for _, e := range errors {
			errorCategoryCounts[e.Category]++
		}
	}

	// Son essay'ler
	var recentEssays []struct {
		ID           string  `json:"id"`
		TopicText    string  `json:"topic_text"`
		OverallScore float64 `json:"overall_score"`
		CreatedAt    string  `json:"created_at"`
		CEFREstimate string  `json:"cefr_estimate"`
	}
	if err := dbQueryDuration("dashboard_stats", func() error {
		return h.DB.Table("essays").
			Select("essays.id, topics.text as topic_text, essay_scores.overall_score, essays.created_at, essay_scores.cefr_estimate").
			Joins("JOIN topics ON topics.id = essays.topic_id").
			Joins("LEFT JOIN essay_scores ON essay_scores.essay_id = essays.id").
			Where("essays.user_id = ?", userID).
			Order("essays.created_at desc").
			Limit(10).
			Scan(&recentEssays).Error
	}); err != nil {
		return nil, err
	}

	return gin.H{
		"total_essays":          totalEssays,
		"average_score":         avgScore,
		"criteria_averages":     criteriaMap,
		"weakest_criterion":     weakest,
		"error_category_counts": errorCategoryCounts,
		"recent_essays":         recentEssays,
	}, nil
}

// dbQueryDuration, bir veritabanı işleminin süresini ölçer ve mlcmon_db_query_duration_seconds
// histogramına kaydeder. Handler etiketiyle hangi endpoint'in ne kadar sürdüğünü izler.
func dbQueryDuration(handler string, fn func() error) error {
	start := time.Now()
	err := fn()
	metrics.DBQueryDurationSeconds.WithLabelValues(handler).Observe(time.Since(start).Seconds())
	return err
}
